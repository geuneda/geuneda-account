<Project Sdk="Microsoft.NET.Sdk">
  <!-- ASP.NET Core 인증 서버 라이브러리. 요청·응답 DTO 와 결과 코드는 Unity 패키지(Runtime/Protocol)의 것을 링크해 한 곳에서 관리한다 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Geuneda.Account.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Geuneda.Account.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup Label="Unity 패키지와 공유">
    <Compile Include="$(AccountRuntimeDir)Protocol/*.cs" LinkBase="Shared/Protocol" />
  </ItemGroup>
</Project>
